#!/usr/bin/env bash
#
# parcel-api — the only thing in this plugin that talks to the network.
#
# A thin bridge between the Omarchy Parcel bar widget and the Parcel app's
# Premium API (https://parcelapp.net/help/api.html). Keeping it in one small
# bash script means the QML never sees the API key, the behaviour is auditable
# in a minute, and it can be tested from any terminal without Omarchy.
#
# Usage:
#   parcel-api deliveries [active|recent] [--max-age SECONDS]
#   parcel-api add <tracking-number> <carrier-code> <description>
#   parcel-api carriers [--refresh]
#   parcel-api status
#
# Every command prints exactly one JSON object on stdout. API and network
# failures are reported inside that object as {"ok":false,"error":...} with
# exit code 0, so the caller has one code path; exit 64 means a usage error.
#
# The API key is read from the login keyring (libsecret, preinstalled on
# Omarchy) under service=omarchy-parcel key=api-key. Store it once with:
#   secret-tool store --label='Parcel API key' service omarchy-parcel key api-key
# PARCEL_API_KEY in the environment overrides the keyring (for tests/CI only).
#
# Rate limits (Parcel's, not ours): deliveries 20/hour, add 20/day. The last
# good deliveries response is cached under $XDG_STATE_HOME/omarchy/parcel so a
# shell restart or a panel open never burns a request, and --max-age lets the
# caller decide how fresh is fresh enough.
#
# Everything this script reads is treated as hostile: the state directory sits
# at a predictable path, so no file in it is opened through a symlink or
# truncated on open, and neither a cache nor an HTTP body is handed to jq
# before its size is bounded.

set -euo pipefail

readonly SERVICE="omarchy-parcel"
readonly KEY_ATTR="api-key"
readonly API="https://api.parcel.app/external"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/parcel"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly BUNDLED_CARRIERS="$SCRIPT_DIR/../data/carriers.json"

# Nothing legitimate here is close to this big: a full deliveries response with
# every event is tens of kilobytes, and supported_carriers.json is ~11 KB. It
# is the ceiling on any single thing we read into memory or feed to jq.
readonly MAX_BYTES=$((1024 * 1024))

usage() {
  sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 64
}

fail() { # <code> <message>  — machine-readable failure, exit 0
  jq -cn --arg code "$1" --arg message "$2" '{ok:false, error:$code, message:$message}'
  exit 0
}

need() {
  for tool in "$@"; do
    command -v "$tool" >/dev/null 2>&1 || fail "missing-tool" "Required tool not found: $tool"
  done
}

# ---- State directory ---------------------------------------------------------
#
# $STATE_DIR/... are guessable paths that any same-uid process can create ahead
# of us. A planted symlink there would otherwise make us truncate, read or
# write whatever it points at, so every open goes through these two helpers.

readonly STATE_BASE="${XDG_STATE_HOME:-$HOME/.local/state}"

# The two components we own (omarchy/parcel) must be real directories. The base
# is the user's to arrange however they like (a symlinked ~/.local/state is
# fine), so the check is that the resolved dir sits under the resolved base.
ensure_state_dir() {
  [[ -L "$STATE_BASE/omarchy" || -L "$STATE_DIR" ]] \
    && fail "unsafe-state" "$STATE_DIR is reached through a symlink; refusing to use it."
  mkdir -p "$STATE_DIR" 2>/dev/null || fail "unsafe-state" "Could not create $STATE_DIR"
  [[ -d "$STATE_DIR" && ! -L "$STATE_DIR" ]] \
    || fail "unsafe-state" "$STATE_DIR is not a plain directory; refusing to use it."
  local real_dir real_base
  real_dir="$(cd "$STATE_DIR" 2>/dev/null && pwd -P)" || fail "unsafe-state" "Cannot resolve $STATE_DIR"
  real_base="$(cd "$STATE_BASE" 2>/dev/null && pwd -P)" || fail "unsafe-state" "Cannot resolve $STATE_BASE"
  [[ "$real_dir" == "$real_base/omarchy/parcel" ]] \
    || fail "unsafe-state" "$STATE_DIR resolves outside $STATE_BASE; refusing to use it."
  chmod 700 "$STATE_DIR" 2>/dev/null || true
}

# A path we may open: either absent, or a plain regular file — never a symlink,
# fifo or device.
safe_path() { # <path>
  [[ -L "$1" ]] && return 1
  [[ -e "$1" && ! -f "$1" ]] && return 1
  return 0
}

file_size() { # <path> → bytes, 0 if unknown
  stat -c %s "$1" 2>/dev/null || stat -f %z "$1" 2>/dev/null || echo 0
}

# Is this cache safe to parse? Present, non-empty, a real file, and small
# enough that jq can hold it. A cache that fails any of these reads as absent.
usable_cache() { # <path>
  safe_path "$1" || return 1
  [[ -s "$1" ]] || return 1
  (( $(file_size "$1") <= MAX_BYTES )) || return 1
  return 0
}

# Bounded read: head caps the bytes that reach jq even if the file grows or is
# swapped between the check above and the read here, and timeout stops a swap
# to a FIFO from blocking us forever. (bash cannot open O_NOFOLLOW; a swap to a
# symlink between check and read is a bounded, same-uid read of a file that
# process could already read itself.)
cache_bytes() { # <path>
  if command -v timeout >/dev/null 2>&1; then
    timeout 5 head -c "$MAX_BYTES" "$1"
  else
    head -c "$MAX_BYTES" "$1"
  fi
}

# The key is written into a curl config file as header = "api-key: <key>".
# Backslash and double quote are escaped the way curl's parser expects; a
# control character (newline especially) would end the directive, so it is the
# one thing refused.
key_is_clean() { # <key>
  [[ "$1" != *[![:print:]]* ]]
}

curl_config_quote() { # <string> → the string escaped for a "..." curl config value
  local v="$1"
  v="${v//\\/\\\\}"
  v="${v//\"/\\\"}"
  printf '%s' "$v"
}

# Exit 1: no key. Exit 2: a key is stored but unusable.
api_key() {
  if [[ -n "${PARCEL_API_KEY:-}" ]]; then
    key_is_clean "$PARCEL_API_KEY" || return 2
    printf '%s' "$PARCEL_API_KEY"
    return 0
  fi
  command -v secret-tool >/dev/null 2>&1 || return 1
  local key
  key="$(secret-tool lookup service "$SERVICE" key "$KEY_ATTR" 2>/dev/null || true)"
  [[ -n "$key" ]] || return 1
  key_is_clean "$key" || return 2
  printf '%s' "$key"
}

# Resolve the key in the main shell (not inside a $(...) capture) so a missing
# key becomes a clean {"ok":false,"error":"no-key"} instead of leaking into a
# captured response body.
KEY=""
require_key() {
  local rc=0
  KEY="$(api_key)" || rc=$?
  case "$rc" in
    0) ;;
    2) fail "bad-key" "The stored Parcel API key contains control characters. Re-create it at web.parcelapp.net and store it again." ;;
    *) fail "no-key" "No Parcel API key found. Store one with: secret-tool store --label='Parcel API key' service $SERVICE key $KEY_ATTR" ;;
  esac
}

# ---- HTTP --------------------------------------------------------------------
#
# The response body is written to a private temp file through `head -c`, so the
# most we ever store or parse is MAX_BYTES no matter what the server sends or
# claims to send — --max-filesize alone can't be trusted for a chunked reply.
# The status code comes back on stderr via %{stderr} so it survives that cap.
# The key travels to curl as a config file on stdin (-K -), never in argv where
# other same-user processes could read it.

BODY_FILE=""
CODE_FILE=""
HTTP_CODE=""
cleanup() { [[ -n "$BODY_FILE" ]] && rm -f "$BODY_FILE" "$CODE_FILE"; return 0; }
trap cleanup EXIT

scratch_files() {
  [[ -n "$BODY_FILE" ]] && return 0
  BODY_FILE="$(mktemp "${TMPDIR:-/tmp}/parcel-api.body.XXXXXX")"
  CODE_FILE="$(mktemp "${TMPDIR:-/tmp}/parcel-api.code.XXXXXX")"
}

request() { # <method> <url> [json-body] → 0 with $HTTP_CODE set; body in $BODY_FILE
  local method="$1" url="$2" body="${3:-}"
  scratch_files
  : >"$BODY_FILE"
  : >"$CODE_FILE"
  local -a args=(-s --proto '=https' --max-time 15 --max-filesize "$MAX_BYTES"
                 -H "Accept: application/json" -o - -w '%{stderr}%{http_code}' -X "$method")
  [[ -n "$body" ]] && args+=(-H "Content-Type: application/json" --data "$body")
  local config=""
  if [[ -n "$KEY" ]]; then
    args=(-K - "${args[@]}")
    config="$(printf 'header = "api-key: %s"\n' "$(curl_config_quote "$KEY")")"
  fi
  local -a st
  printf '%s' "$config" \
    | curl "${args[@]}" "$url" 2>"$CODE_FILE" \
    | head -c "$MAX_BYTES" >"$BODY_FILE" && st=(0 0 0) || st=("${PIPESTATUS[@]}")
  HTTP_CODE="$(tr -cd '0-9' <"$CODE_FILE" | head -c 3)"
  [[ "${st[2]}" == 0 ]] || return 1                        # could not write the body
  case "${st[1]}" in
    0) ;;
    # 23 = write error (head closed the pipe), 63 = --max-filesize: both mean
    # "the body hit the cap", which the caller reports as too-large. Anything
    # else — a connection dropped mid-body included — is a failed transfer.
    23|63) (( $(file_size "$BODY_FILE") >= MAX_BYTES )) || return 1 ;;
    *) return 1 ;;
  esac
  [[ -n "$HTTP_CODE" && "$HTTP_CODE" != "000" ]]
}

response_body() {
  [[ -s "$BODY_FILE" ]] && cat "$BODY_FILE"
  return 0
}

file_age() { # <path> → seconds since modification, or a huge number
  local now mtime
  now="$(date +%s)"
  if mtime="$(stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null)"; then
    echo $(( now - mtime ))
  else
    echo 999999999
  fi
}

write_cache() { # <path> <json>
  ensure_state_dir
  safe_path "$1" || fail "unsafe-state" "Refusing to write through $1"
  local tmp
  tmp="$(mktemp "$STATE_DIR/.tmp.XXXXXX")"
  (umask 077; printf '%s\n' "$2" > "$tmp")
  chmod 600 "$tmp"
  mv -f "$tmp" "$1"   # rename(2) replaces the name, it never follows a symlink
}

# Read a cache through jq. Output is captured and printed only if jq succeeds,
# so a corrupt cache (say a valid object with junk appended) can never put one
# JSON document on stdout and then let a second one follow it.
emit_cache() { # <cache-path> <jq-filter> [jq-args...]
  local path="$1" filter="$2" out
  shift 2
  usable_cache "$path" || return 1
  out="$(cache_bytes "$path" | jq -c "$@" "$filter" 2>/dev/null)" || return 1
  [[ -n "$out" && "$out" != *$'\n'* ]] || return 1
  printf '%s\n' "$out"
}

serve_cache_or_fail() { # <cache-path> <error-code> <message>
  if emit_cache "$1" '. + {stale:true, error:$code, message:$message}' --arg code "$2" --arg message "$3"; then
    exit 0
  fi
  fail "$2" "$3"
}

cmd_deliveries() {
  need curl jq
  local mode="active" max_age=0
  while (($#)); do
    case "$1" in
      active|recent) mode="$1" ;;
      --max-age) shift; max_age="${1:-0}" ;;
      --max-age=*) max_age="${1#--max-age=}" ;;
      *) usage ;;
    esac
    shift
  done
  [[ "$max_age" =~ ^[0-9]+$ ]] || usage

  ensure_state_dir
  local cache="$STATE_DIR/deliveries-$mode.json"

  # One panel instance exists per monitor and they all poll on the same
  # schedule. Serialise callers so the first one fetches and the rest find a
  # fresh cache inside the lock — several monitors cost one API request.
  #
  # The lock is taken on the state directory itself (opened read-only), so
  # there is no lock file at a guessable path to plant, truncate or redirect.
  # A timed-out or failed lock falls through to an unserialised fetch: a
  # duplicate request beats a panel that never loads.
  if command -v flock >/dev/null 2>&1 && exec 9<"$STATE_DIR" 2>/dev/null; then
    flock -w 30 9 || true
  fi

  # A forced refresh (--max-age 0) still treats a cache under 10 s old as
  # fresh, so a broadcast refresh across monitors is also a single request.
  local effective_max_age="$max_age"
  (( effective_max_age < 10 )) && effective_max_age=10
  # An unparseable cache falls through to a fetch instead of aborting.
  if usable_cache "$cache" && (( $(file_age "$cache") < effective_max_age )) \
     && emit_cache "$cache" '. + {cached:true}'; then
    return 0
  fi

  require_key
  local body
  if ! request GET "$API/deliveries/?filter_mode=$mode"; then
    serve_cache_or_fail "$cache" "network" "Could not reach api.parcel.app"
  fi
  if (( $(file_size "$BODY_FILE") >= MAX_BYTES )); then
    serve_cache_or_fail "$cache" "too-large" "Parcel returned an oversized response."
  fi
  body="$(response_body)"

  case "$HTTP_CODE" in
    200) ;;
    401|403) fail "auth" "Parcel rejected the API key (HTTP $HTTP_CODE). Re-create it at web.parcelapp.net and store it again." ;;
    429) serve_cache_or_fail "$cache" "rate-limited" "Parcel rate limit reached (20 requests/hour). Showing the last good data." ;;
    *) serve_cache_or_fail "$cache" "http-$HTTP_CODE" "Unexpected response from Parcel (HTTP $HTTP_CODE)." ;;
  esac

  if ! jq -e 'type == "object"' <<<"$body" >/dev/null 2>&1; then
    serve_cache_or_fail "$cache" "bad-response" "Parcel returned something that is not JSON."
  fi
  if [[ "$(jq -r '.success' <<<"$body")" != "true" ]]; then
    local msg
    msg="$(jq -r '(.error_message // "Parcel reported an error.") | tostring | .[0:200]' <<<"$body")"
    serve_cache_or_fail "$cache" "api" "$msg"
  fi
  # A "successful" body without a deliveries array is not a result we can
  # trust — never cache it, and never let it read as "nothing on the way".
  if ! jq -e '.deliveries | type == "array"' <<<"$body" >/dev/null 2>&1; then
    serve_cache_or_fail "$cache" "bad-response" "Parcel returned no deliveries list."
  fi

  # Cap the list here too: the widget clamps what it renders, but the cache is
  # what a later run parses, and it should never grow past what we just read.
  # Non-object deliveries are dropped and a non-array .events becomes [] —
  # Model.js would ignore them anyway, and the shaping must never be the thing
  # that turns a usable response into an empty stdout.
  local out
  out="$(jq -c --arg mode "$mode" --argjson now "$(date +%s)" '
    {ok:true, mode:$mode, fetchedAt:$now, cached:false, stale:false,
     deliveries:(.deliveries[0:200] | map(select(type == "object")
       | .events = (if (.events | type) == "array" then .events[0:50] else [] end)))}' <<<"$body")" \
    || serve_cache_or_fail "$cache" "bad-response" "Parcel returned a deliveries list we could not read."
  write_cache "$cache" "$out"
  printf '%s\n' "$out"
}

cmd_add() {
  need curl jq
  (($# == 3)) || usage
  local tracking="$1" carrier="$2" description="$3"
  [[ -n "$tracking" && -n "$carrier" && -n "$description" ]] || usage
  require_key
  local payload body
  payload="$(jq -cn --arg t "$tracking" --arg c "$carrier" --arg d "$description" \
    '{tracking_number:$t, carrier_code:$c, description:$d, send_push_confirmation:true}')"
  if ! request POST "$API/add-delivery/" "$payload"; then
    fail "network" "Could not reach api.parcel.app"
  fi
  body="$(response_body)"
  case "$HTTP_CODE" in
    200) ;;
    401|403) fail "auth" "Parcel rejected the API key (HTTP $HTTP_CODE)." ;;
    429) fail "rate-limited" "Parcel add-delivery limit reached (20 per day)." ;;
    *) fail "http-$HTTP_CODE" "Unexpected response from Parcel (HTTP $HTTP_CODE)." ;;
  esac
  if [[ "$(jq -r '.success' <<<"$body" 2>/dev/null)" == "true" ]]; then
    jq -cn --arg t "$tracking" --arg c "$carrier" --arg d "$description" \
      '{ok:true, added:{tracking_number:$t, carrier_code:$c, description:$d}}'
  else
    fail "api" "$(jq -r '(.error_message // "Parcel could not add the delivery.") | tostring | .[0:200]' <<<"$body" 2>/dev/null)"
  fi
}

cmd_carriers() {
  need jq
  ensure_state_dir
  local cache="$STATE_DIR/carriers.json"
  if [[ "${1:-}" == "--refresh" ]]; then
    need curl
    KEY=""
    if request GET "$API/supported_carriers.json" \
       && [[ "$HTTP_CODE" == "200" ]] \
       && (( $(file_size "$BODY_FILE") < MAX_BYTES )); then
      local fresh
      fresh="$(response_body)"
      if jq -e 'type == "object"' <<<"$fresh" >/dev/null 2>&1; then
        write_cache "$cache" "$fresh"
      fi
    fi
  fi
  if emit_cache "$cache" '{ok:true, source:"cache", carriers:.}'; then
    :
  elif [[ -s "$BUNDLED_CARRIERS" ]]; then
    jq -c '{ok:true, source:"bundled", carriers:.}' "$BUNDLED_CARRIERS"
  else
    fail "no-carriers" "No carrier list available."
  fi
}

cmd_status() {
  need jq
  local has_key=false has_secret_tool=false
  command -v secret-tool >/dev/null 2>&1 && has_secret_tool=true
  api_key >/dev/null 2>&1 && has_key=true
  local cache="$STATE_DIR/deliveries-active.json" cached_at=null
  if usable_cache "$cache"; then
    cached_at="$(cache_bytes "$cache" | jq -r '(.fetchedAt // null) | tostring' 2>/dev/null | head -n1 || true)"
    [[ "$cached_at" =~ ^[0-9]+$ ]] || cached_at=null
  fi
  jq -cn --argjson hasKey "$has_key" --argjson secretTool "$has_secret_tool" \
    --arg stateDir "$STATE_DIR" --argjson cachedAt "$cached_at" \
    '{ok:true, hasKey:$hasKey, secretTool:$secretTool, stateDir:$stateDir, lastFetchedAt:$cachedAt}'
}

(($#)) || usage
cmd="$1"; shift
case "$cmd" in
  deliveries) cmd_deliveries "$@" ;;
  add) cmd_add "$@" ;;
  carriers) cmd_carriers "$@" ;;
  status) cmd_status "$@" ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac
